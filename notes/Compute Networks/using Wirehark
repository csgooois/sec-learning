# 基础定位
ip.addr == 192.168.1.10          # 与该 IP 相关的所有包（源或目的）
tcp.port == 80                   # 80 端口（源或目的）
tcp.srcport == 8080              # 只看源端口
dns / http / tls / arp / icmp    # 按协议过滤

# 握手与连接状态
tcp.flags.syn == 1 && tcp.flags.ack == 0   # 三次握手第一个包
tcp.flags.reset == 1             # RST：端口关闭或被拒绝
tcp.flags.fin == 1               # FIN：正常关闭
tcp.analysis.retransmission      # 重传：丢包或网络拥塞
tcp.analysis.flags               # 让 Wireshark 自己标出异常包（排查首选）

# HTTP
http.request.method == "POST"    # 只看 POST
http.response.code >= 400        # 只看错误响应
http contains "password"         # 明文传输的敏感词（这就是要用 HTTPS 的原因）
http.cookie                      # 看 Cookie 怎么传的

# TLS
tls.handshake.type == 1          # ClientHello
tls.handshake.type == 11         # Certificate（服务端下发证书）
tls.handshake.extensions_server_name   # SNI：明文暴露你访问哪个域名

# 组合与排除
ip.src == 192.168.1.10 && tcp.flags.syn == 1 && !(tcp.flags.ack == 1)
!(arp || dns)                    # 排除噪声，只看业务流量

